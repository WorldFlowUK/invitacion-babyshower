# Opción A: webhook propio (recomendado si ya usas n8n).
# El RSVP se envía como POST JSON a esta URL; desde ahí puedes reenviarlo
# a Sheets, Zoho, WhatsApp, correo, etc.
VITE_RSVP_WEBHOOK_URL=

# Opción B: Supabase directo.
# Usa exclusivamente la anon/public key aquí, nunca la service role key.
# Configura RLS en la tabla `rsvps` para permitir solo INSERT anónimo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
